# PostgreSQL (desarrollo local mediante Docker Compose)
APP_ENVIRONMENT=development
POSTGRES_DB=asfaltos_crm
POSTGRES_USER=asfaltos
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Autenticación JWT (reemplazar por un valor aleatorio seguro fuera de desarrollo)
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# Firma HMAC del intake Web (solo servidores; nunca exponer en JavaScript)
WEB_INTAKE_SIGNING_SECRET=replace_with_a_distinct_32_character_secret

# Oportunidades sin cambio de etapa antes de generar un aviso interno
STALE_OPPORTUNITY_DAYS=14

# WhatsApp (usar fake sin credenciales; completar META_* solo al seleccionar meta)
WHATSAPP_PROVIDER=fake
WHATSAPP_DEV_ROUTES_ENABLED=false
WHATSAPP_MEDIA_STORAGE=filesystem
WHATSAPP_MEDIA_STORAGE_ROOT=/var/lib/asfaltos-crm/whatsapp-media
WHATSAPP_IMAGE_MAX_BYTES=16777216
WHATSAPP_DOCUMENT_MAX_BYTES=16777216
WHATSAPP_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
WHATSAPP_DOCUMENT_MIME_TYPES=application/pdf
WHATSAPP_BROADCAST_BATCH_SIZE=10
WHATSAPP_BROADCAST_CLAIM_TIMEOUT_SECONDS=300
META_GRAPH_API_VERSION=v26.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_REQUEST_TIMEOUT_SECONDS=10
META_RETRY_MAX_ATTEMPTS=3
META_RETRY_BASE_SECONDS=0.25
META_RETRY_MAX_SECONDS=2

# Puertos expuestos al host
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend (usar /api para aprovechar el proxy de Vite en Docker)
VITE_API_BASE_URL=/api
